      render(); break;
    }
    case 'roll': act({ t: 'roll', dice: UI.rollSel.slice() }); break;
    case 'endTurn': UI.sel = null; UI.flow = null; act({ t: 'end' }); break;
    case 'reroll': act({ t: 'reroll', tok: id }); break;
    case 'tokD': {
