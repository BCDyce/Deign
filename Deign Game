// ============================================================ PATH VARIANTS
const VARIANTS = (function () {
  const out = [], seen = {};
  PATH_SHAPES.forEach(function (sh, si) {
    for (let flip = 0; flip < 2; flip++) for (let rot = 0; rot < 4; rot++) {
      const tf = function (p) {
        let x = p[0], y = p[1];
        if (flip) x = -x;
        for (let r = 0; r < rot; r++) { const nx = -y, ny = x; x = nx; y = ny; }
        return [x, y];
      };
      const a = tf(sh.anchor);
      const offs = sh.cells.map(function (c) { const t = tf(c); return [t[0] - a[0], t[1] - a[1]]; });
      const key = si + ':' + offs.map(function (o) { return o.join(','); }).sort().join('|');
      if (seen[key]) continue; seen[key] = 1;
      out.push({ shape: si, shapeName: sh.name, rot: rot, flip: flip, offs: offs });
    }
  });
  return out;
})();

// ============================================================ HELPERS
const DIRS = [[1,0],[-1,0],[0,1],[0,-1]];
const inb = function (x, y) { return x >= 0 && y >= 0 && x < W && y < H; };
const cd = function (a) { return CARDS[a.cid]; };
function log(S, m) { if (S.log) { S.log.push(m); if (S.log.length > 80) S.log.shift(); } }
function pname(S, p) { return S.pl[p].name; }
function aname(S, a) {
  const c = cd(a);
  if (c.tags.indexOf('disaster') >= 0) return 'Disaster ' + c.name.split(', ')[1].split(' ')[0];
  return c.name.split(',')[0].replace(/^The /, '');
}
function boardUnits(S, p) {
  const r = [];
  for (const id in S.aco) { const a = S.aco[id]; if (a.st === 'board' && (p === undefined || a.owner === p)) r.push(a); }
  return r;
}
function unitAt(S, x, y) {
  for (const id in S.aco) { const a = S.aco[id]; if (a.st === 'board' && a.x === x && a.y === y) return a; }
  return null;
}
function fontAt(S, x, y) {
  for (let p = 0; p < 2; p++) { const f = S.fonts[p]; if (!f.dead && f.x === x && f.y === y) return p; }
  return -1;
}
function pathIdAt(S, x, y) { return inb(x, y) ? S.cells[y][x] : null; }
function built(S, x, y) { return inb(x, y) && S.cells[y][x] !== null; }

// ============================================================ EFFECT ACTIVITY
function suppressed(S, a) {
  const bu = boardUnits(S);
  const ilimanExcept = function (x) { return bu.some(function (c) { return c !== x && c.abil === 'iliman'; }); };
  if (ilimanExcept(a)) return true;
  for (const g of bu) {
    if (g.abil === 'gogmagog' && g.owner !== a.owner && !ilimanExcept(g)) return true;
  }
  return false;
}
function ab(S, a) {
  if (a.st !== 'board' || suppressed(S, a)) return [];
  const r = [];
  if (a.abil) r.push(a.abil);
  if (a.zoa) for (const k in a.zoa) for (let i = 0; i < a.zoa[k]; i++) r.push('z_' + k);
  return r;
}
function has(S, a, k) { return ab(S, a).indexOf(k) >= 0; }
function effectless(S, a) { return ab(S, a).length === 0; }
function ownerHas(S, p, k) { return boardUnits(S, p).some(function (u) { return has(S, u, k); }); }
function immune(S, t, src) {
  return t.owner !== src.owner && t.zoa && t.zoa.charlotte > 0 && !suppressed(S, t);
}
const adj = function (a, b) { return Math.abs(a.x - b.x) + Math.abs(a.y - b.y) === 1; };

// ============================================================ STATS
function stat(S, a, skipSeo) {
  const b = cd(a).stats;
  let m = b[0], at = b[1], d = b[2];
  const bu = boardUnits(S);
  const act = bu.map(function (s) { return { s: s, k: ab(S, s) }; }).filter(function (o) { return o.k.length; });
  const emi = act.some(function (o) { return o.k.indexOf('emiliano') >= 0; });
  if (a.st === 'board') {
    if (!emi) {
      m += a.mods[0]; at += a.mods[1]; d += a.mods[2];
      const myPath = pathIdAt(S, a.x, a.y);
      for (const o of act) {
        const s = o.s;
        for (const k of o.k) {
          switch (k) {
            case 'seojun': if (!skipSeo && s !== a && effectless(S, a) && !immune(S, a, s)) { const ss = stat(S, s, true); at += ss.a; d += ss.d; } break;
            case 'z_ella': if (a.owner !== s.owner && !immune(S, a, s)) m -= 1; break;
            case 'z_angus': if (a.owner !== s.owner && !immune(S, a, s)) at -= 1; break;
            case 'gwaaganad': if (s === a && S.pl[a.owner].elysium.length === 0) { at += 3; d += 3; } break;
            case 'caoimhin': if (a.cid === 'caoimhin' && !immune(S, a, s)) { at += 1; d += 1; } break;
            case 'sebastian': if (s !== a && s.owner === a.owner && adj(s, a)) { at += 2; d += 2; } break;
            case 'alicia': if (s.owner === a.owner) { at += 0.5; d += 0.5; } break;
            case 'antoine': if (!immune(S, a, s)) { at -= 1; d -= 1; } break;
            case 'salem': if (s.owner !== a.owner && s.dPath && myPath === s.dPath && !immune(S, a, s)) { at -= 1; d -= 1; } break;
            case 'gianluca': if (s.dPath && myPath === s.dPath && !immune(S, a, s)) { at -= 1; d -= 1; } break;
            case 'egg5': if (s === a && a.hatched) { m += 5; at += 5; d += 5; } break;
            case 'egg3': if (s === a && a.hatched) { m += 3; at += 3; d += 3; } break;
          }
        }
      }
    }
    for (const o of act) {
      for (const k of o.k) {
        if (k === 'victor' && o.s === a) { const l = S.lastDest || [0, 0, 0]; m = l[0]; at = l[1]; d = l[2]; }
        if (k === 'tim' && !immune(S, a, o.s)) m = 2;
      }
    }
  }
  return { m: Math.max(0, m), a: Math.max(0, at), d: Math.max(0, d) };
}
function fontStat(S, p) {
  let m = 0, a = 0, d = 0;
  boardUnits(S, p).forEach(function (u) {
    ab(S, u).forEach(function (k) { if (k === 'heaven14') m += 2; if (k === 'heaven23') a += 2; if (k === 'heaven41') d += 2; });
  });
  return { m: m, a: a, d: d };
}

// ============================================================ GAME SETUP
function newGame(setup) {
  const first = setup.first === 0 || setup.first === 1 ? setup.first : (Math.random() < 0.5 ? 0 : 1);
  const S = {
    rev: 0, turnNo: 0, cur: first, first: first, phase: 'roll', winner: null, reason: '',
    cells: [], paths: {}, pathN: 0, fonts: [], aco: {}, dice: {}, pl: [], tokens: [], tokN: 0,
    rerolls: 0, pending: null, lastDest: null, log: []
  };
  for (let y = 0; y < H; y++) { S.cells.push(new Array(W).fill(null)); }
  S.fonts = [
    { x: Math.floor(W / 2), y: H - 1, survived: 0, shroud: false, dead: false },
    { x: Math.floor(W / 2), y: 0, survived: 0, shroud: false, dead: false }
  ];
  for (let p = 0; p < 2; p++) {
    const pool = setup.pools[p];
    const pl = { name: setup.names[p], ai: !!(setup.ai && setup.ai[p]), acos: [], dice: [], elysium: [], firstDesc: false };
    pool.cards.forEach(function (cid, i) {
      const id = 'a' + p + '_' + i, did = 'd' + p + '_' + i;
      S.aco[id] = { id: id, cid: cid, owner: p, home: p, st: 'pool', x: null, y: null, dPath: null, mods: [0, 0, 0],
        abil: CARDS[cid].abil, zoa: null, hatched: false, eggT: 0, soniaTurn: -1, siti: null, alexi: false };
      S.dice[did] = { id: did, owner: p, tier: CARDS[cid].tier, rainbow: pool.rainbow === i, st: 'pool' };
      pl.acos.push(id); pl.dice.push(did);
    });
    S.pl.push(pl);
  }
  log(S, pname(S, first) + ' goes first and rolls only ' + FIRST_TURN_ROLL + ' dice on the first turn.');
  startTurn(S);
  return S;
}

function poolDice(S, p) { return S.pl[p].dice.filter(function (d) { return S.dice[d].st === 'pool'; }); }
function rollLimit(S) { return Math.min(S.turnNo === 0 ? FIRST_TURN_ROLL : MAX_ROLL, poolDice(S, S.cur).length); }
function startTurn(S) {
  S.tokens = []; S.rerolls = 0; S.phase = 'roll';
  if (poolDice(S, S.cur).length === 0) {
    const other = poolDice(S, 1 - S.cur).length;
    if (other === 0) { endGame(S, null, 'Both players are out of dice.'); return; }
    S.phase = 'act'; log(S, pname(S, S.cur) + ' has no dice left to roll.');
  }
}

// ============================================================ END / WIN
function endGame(S, w, reason) {
  S.phase = 'over'; S.winner = w; S.reason = reason; S.pending = null;
  log(S, w === null ? 'Game drawn. ' + reason : pname(S, w) + ' wins! ' + reason);
}
function checkEnd(S) {
  if (S.phase === 'over') return;
  for (let p = 0; p < 2; p++) if (S.fonts[p].dead) { endGame(S, 1 - p, pname(S, p) + '\'s Font was destroyed.'); return; }
  if (S.pl[0].firstDesc && S.pl[1].firstDesc) {
    const n0 = boardUnits(S, 0).length, n1 = boardUnits(S, 1).length;
    if (n0 === 0 && n1 === 0) endGame(S, null, 'Both boards are empty.');
    else if (n0 === 0) endGame(S, 1, pname(S, 0) + ' has no Acolytes left on the board.');
    else if (n1 === 0) endGame(S, 0, pname(S, 1) + ' has no Acolytes left on the board.');
  }
  if (S.phase !== 'over' && S.turnNo >= TURN_CAP) endGame(S, null, 'Turn limit reached.');
}

// ============================================================ DESTRUCTION
function destroy(S, a, by, opts) {
  opts = opts || {};
  if (a.st !== 'board') return false;
  if (!opts.noSonia && has(S, a, 'sonia') && a.soniaTurn !== S.turnNo) {
    a.soniaTurn = S.turnNo; a.mods[1] += 1;
    log(S, aname(S, a) + ' is renewed (+1 Attack) instead of being destroyed.');
    return false;
  }
  const st = stat(S, a);
  S.lastDest = [st.m, st.a, st.d];
  const siti = a.siti, wasSiti = has(S, a, 'siti');
  a.st = opts.to || 'elysium'; a.x = null; a.y = null;
  if (a.st === 'elysium') S.pl[a.home].elysium.push(a.id);
  log(S, aname(S, a) + ' is destroyed' + (a.st === 'lili' ? ' (to Lilili\'s Zone).' : '.'));
  if (wasSiti && siti && S.aco[siti] && S.aco[siti].st === 'board') {
    log(S, 'Siti\'s link takes ' + aname(S, S.aco[siti]) + ' with it.');
    destroy(S, S.aco[siti], null, {});
  }
  return true;
}

// ============================================================ PLACEMENT
function cellsOf(v, ax, ay) { return v.offs.map(function (o) { return [ax + o[0], ay + o[1]]; }); }
function canPlace(S, p, vi, ax, ay) {
  const v = VARIANTS[vi]; if (!v) return false;
  const cs = cellsOf(v, ax, ay);
  let attach = false;
  for (const c of cs) {
    if (!inb(c[0], c[1])) return false;
    if (S.cells[c[1]][c[0]] !== null) return false;
    if (fontAt(S, c[0], c[1]) >= 0) return false;
    if (unitAt(S, c[0], c[1])) return false;
  }
  for (const c of cs) for (const d of DIRS) {
    const nx = c[0] + d[0], ny = c[1] + d[1];
    if (!inb(nx, ny)) continue;
    const f = S.fonts[p];
    if (!f.dead && f.x === nx && f.y === ny) attach = true;
    const pid = S.cells[ny][nx];
    if (pid && S.paths[pid].owner === p) attach = true;
  }
  return attach;
}
function placements(S, p, onlyShape) {
  const out = [];
  VARIANTS.forEach(function (v, vi) {
    if (onlyShape !== undefined && v.shape !== onlyShape) return;
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) if (canPlace(S, p, vi, x, y)) out.push({ vi: vi, ax: x, ay: y });
  });
  return out;
}
