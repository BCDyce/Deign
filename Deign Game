<title>Deign</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Marcellus&display=swap">
<style>
/* Layout: a single working surface. Board dominates on the left; turn controls, card inspector and log stack on the right. On phones everything stacks: status, controls, board, info. */
:root {
  --bg: #e8ebf1;
  --panel: #f5f6fa;
  --panel2: #dde2ea;
  --line: #c2c9d6;
  --fg: #161a23;
  --mute: #566073;
  --cell: #d3d9e3;
  --cell-line: #b7bfce;
  --me: #b24d17;
  --me-soft: #f0cbb2;
  --foe: #1f60b3;
  --foe-soft: #bcd3ee;
  --accent: #7d5f08;
  --accent-soft: #eadba8;
  --ok: #23804b;
  --bad: #b32a38;
  --t-apex: #6a47b8;
  --t-gold: #a07400;
  --t-silver: #657083;
  --t-bronze: #96552a;
  --on-solid: #ffffff;
  --font-display: "Marcellus", "Iowan Old Style", Georgia, serif;
  --font-body: "Hanken Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0e1117;
    --panel: #161a23;
    --panel2: #1e2330;
    --line: #2b3242;
    --fg: #e5e8ef;
    --mute: #98a2b5;
    --cell: #252935;
    --cell-line: #0f1218;
    --me: #f08a58;
    --me-soft: #5a3423;
    --foe: #6ba6f3;
    --foe-soft: #243a5c;
    --accent: #e2b955;
    --accent-soft: #4a3d17;
    --ok: #4cc47f;
    --bad: #f0707c;
    --t-apex: #a98ff0;
    --t-gold: #e0b43a;
    --t-silver: #aab4c6;
    --t-bronze: #d98a52;
    --on-solid: #10131a;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0e1117;
  --panel: #161a23;
  --panel2: #1e2330;
  --line: #2b3242;
  --fg: #e5e8ef;
  --mute: #98a2b5;
  --cell: #252935;
  --cell-line: #0f1218;
  --me: #f08a58;
  --me-soft: #5a3423;
  --foe: #6ba6f3;
  --foe-soft: #243a5c;
  --accent: #e2b955;
  --accent-soft: #4a3d17;
  --ok: #4cc47f;
  --bad: #f0707c;
  --t-apex: #a98ff0;
  --t-gold: #e0b43a;
  --t-silver: #aab4c6;
  --t-bronze: #d98a52;
  --on-solid: #10131a;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 15px; line-height: 1.45; }
#app { max-width: 1240px; margin-inline: auto; padding-inline: 16px; padding-block: 20px 40px; }
h1, h2, h3 { font-family: var(--font-display); font-weight: 400; margin: 0; text-wrap: balance; letter-spacing: .01em; }
button { font: inherit; color: inherit; cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .45; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.eyebrow { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--mute); font-weight: 600; }
.muted { color: var(--mute); }

/* Buttons */
.btn { background: var(--panel2); border: 1px solid var(--line); border-radius: 8px; padding: 9px 14px; font-weight: 600; line-height: 1.1; }
.btn:hover:not(:disabled) { border-color: var(--mute); }
.btn.primary { background: var(--accent); color: var(--on-solid); border-color: var(--accent); }
.btn.primary:hover:not(:disabled) { filter: brightness(1.08); }
.btn.quiet { background: transparent; }
.btn.danger { color: var(--bad); }
.btn.sm { padding: 6px 10px; font-size: 13px; }
.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

/* Home */
.home { display: grid; gap: 28px; padding-top: 4vh; }
.mast { display: grid; gap: 10px; max-width: 640px; }
.mast h1 { font-size: clamp(54px, 11vw, 104px); line-height: .95; letter-spacing: .04em; }
.mast p { font-size: 17px; color: var(--mute); margin: 0; max-width: 54ch; }
.modes { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); max-width: 860px; }
.mode { text-align: left; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px; display: grid; gap: 6px; min-width: 0; }
.mode:hover:not(:disabled) { border-color: var(--accent); }
.mode h3 { font-size: 22px; }
.mode span { color: var(--mute); font-size: 14px; }
.note { font-size: 13px; color: var(--mute); max-width: 70ch; }
details.rules { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; max-width: 860px; }
details.rules summary { cursor: pointer; font-weight: 600; }
details.rules ul { margin: 10px 0 0; padding-left: 18px; display: grid; gap: 6px; }

/* Setup */
.setup { display: grid; gap: 18px; }
.setup-top { display: flex; gap: 16px; justify-content: space-between; align-items: end; flex-wrap: wrap; }
.field { display: grid; gap: 4px; }
.field label { font-size: 12px; color: var(--mute); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
.field input, .field select { background: var(--panel); color: var(--fg); border: 1px solid var(--line); border-radius: 8px; padding: 9px 12px; font: inherit; min-width: 0; }
.pools { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
.pool { text-align: left; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px; display: grid; gap: 6px; min-width: 0; align-content: start; }
.pool:hover { border-color: var(--mute); }
.pool[aria-pressed="true"] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
.pool h3 { font-size: 18px; }
.pool p { margin: 0; font-size: 12.5px; color: var(--mute); }
.pips { display: flex; gap: 4px; }
.pip { font-family: var(--font-mono); font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 99px; border: 1px solid currentColor; }
.t-apex { color: var(--t-apex); } .t-gold { color: var(--t-gold); } .t-silver { color: var(--t-silver); } .t-bronze { color: var(--t-bronze); } .t-rainbow { color: var(--accent); }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: grid; gap: 12px; min-width: 0; }
.panel h3 { font-size: 19px; }
.chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chip { background: var(--panel2); border: 1px solid var(--line); border-radius: 7px; padding: 4px 8px; font-size: 13px; display: inline-flex; gap: 6px; align-items: center; min-width: 0; }
.chip .dot { width: 8px; height: 8px; border-radius: 2px; background: currentColor; flex: none; }
.chip.on-board { border-color: var(--mute); }
.chip.gone { opacity: .45; text-decoration: line-through; }
.chip.lili { opacity: .45; font-style: italic; }
.chip.sel { border-color: var(--accent); }
button.chip:hover { border-color: var(--accent); }
.split { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 900px) { .split { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); } }
.cardbox { display: grid; gap: 6px; }
.cardbox h4 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 18px; }
.statline { font-family: var(--font-mono); font-size: 13px; display: flex; gap: 10px; flex-wrap: wrap; }
.statline b { font-weight: 700; }
.statline .up { color: var(--ok); } .statline .dn { color: var(--bad); }
.cardbox p { margin: 0; font-size: 13.5px; }

/* Builder */
.catalog { display: grid; gap: 4px; max-height: 420px; overflow: auto; border: 1px solid var(--line); border-radius: 10px; padding: 6px; background: var(--bg); }
.crow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 6px 8px; border-radius: 7px; }
.crow:hover { background: var(--panel2); }
.crow .nm { min-width: 0; overflow-wrap: anywhere; }
.crow .nm small { display: block; color: var(--mute); font-size: 12px; }
.qty { display: inline-flex; gap: 6px; align-items: center; }
.qty button { width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--line); background: var(--panel2); font-weight: 700; padding: 0; }
.tierhead { position: sticky; top: 0; background: var(--bg); padding: 6px 8px 2px; z-index: 1; }

/* Lobby */
.code { font-family: var(--font-mono); font-size: clamp(36px, 8vw, 64px); letter-spacing: .25em; font-weight: 700; color: var(--accent); }

/* Game */
.game { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); grid-template-areas: "head" "ctrl" "board" "info"; }
@media (min-width: 980px) {
  .game { grid-template-columns: minmax(0, 1fr) 372px; grid-template-areas: "head head" "board ctrl" "board info"; align-items: start; }
}
.ghead { grid-area: head; display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.ghead h1 { font-size: 30px; letter-spacing: .06em; }
.who { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font-size: 14px; }
.sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
.sw.me { background: var(--me); } .sw.foe { background: var(--foe); }
.turnpill { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 99px; background: var(--panel2); border: 1px solid var(--line); }
.turnpill.on { background: var(--accent); color: var(--on-solid); border-color: var(--accent); }
.gctrl { grid-area: ctrl; display: grid; gap: 12px; min-width: 0; }
.ginfo { grid-area: info; display: grid; gap: 12px; min-width: 0; }
.gboard { grid-area: board; min-width: 0; }
.banner { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: grid; gap: 4px; }
.banner strong { font-family: var(--font-display); font-weight: 400; font-size: 20px; }
.banner.mine { border-color: var(--accent); }
.banner.over { border-color: var(--accent); background: var(--accent-soft); }
.boardwrap { container-type: inline-size; width: 100%; max-width: 800px; margin-inline: auto; }
.board { display: grid; gap: 2px; background: var(--cell-line); padding: 2px; border-radius: 10px; width: 100%; }
.cell { position: relative; background: var(--cell); border: 0; border-radius: 3px; padding: 0; min-width: 0; min-height: 0; display: grid; place-items: center; cursor: default; color: inherit; }
.cell.pm { background: var(--me-soft); box-shadow: inset 0 0 0 1px var(--me); }
.cell.pf { background: var(--foe-soft); box-shadow: inset 0 0 0 1px var(--foe); }
.cell.can { cursor: pointer; }
.cell.mv::after { content: ""; position: absolute; inset: 33%; border-radius: 50%; background: var(--ok); opacity: .9; pointer-events: none; }
.cell.anc::after { content: ""; position: absolute; inset: 40%; border-radius: 50%; background: var(--accent); opacity: .55; pointer-events: none; }
.cell.at { box-shadow: inset 0 0 0 2px var(--bad); }
.cell.pk { box-shadow: inset 0 0 0 2px var(--accent); animation: pulse 1.2s ease-in-out infinite; }
.cell.plok { background: color-mix(in srgb, var(--ok) 38%, var(--cell)); box-shadow: inset 0 0 0 1px var(--ok); }
.cell.plbad { background: color-mix(in srgb, var(--bad) 32%, var(--cell)); box-shadow: inset 0 0 0 1px var(--bad); }
.cell.land::before { content: "▼"; position: absolute; top: 2%; left: 8%; font-size: max(7px, 1.6cqw); color: var(--accent); }
@keyframes pulse { 50% { opacity: .55; } }
@media (prefers-reduced-motion: reduce) { .cell.pk { animation: none; } }
.unit { width: 86%; height: 86%; border-radius: 22%; display: grid; align-content: center; justify-items: center; line-height: 1.05; color: var(--on-solid); font-weight: 700; pointer-events: none; }
.unit.me { background: var(--me); } .unit.foe { background: var(--foe); }
.unit.sel { outline: 2px solid var(--accent); outline-offset: 1px; }
.unit.font { border-radius: 40%; }
.unit b { font-size: max(7.5px, 1.95cqw); font-weight: 700; }
.unit i { font-style: normal; font-family: var(--font-mono); font-size: max(6px, 1.3cqw); opacity: .9; }
.unit i .up { text-decoration: underline; } .unit i .dn { text-decoration: line-through; }
.unit.tint-lili { box-shadow: 0 0 0 2px var(--t-apex); }
.legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--mute); margin-top: 8px; justify-content: center; }
.legend span::before { content: ""; display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; background: var(--c); }

/* Dice and tokens */
.dice { display: flex; gap: 8px; flex-wrap: wrap; }
.die { background: var(--panel2); border: 2px solid currentColor; border-radius: 10px; padding: 8px 10px; display: grid; gap: 2px; justify-items: center; min-width: 64px; font-weight: 600; }
.die small { color: var(--mute); font-weight: 500; font-size: 11px; }
.die[aria-pressed="true"] { background: color-mix(in srgb, currentColor 22%, var(--panel2)); box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 40%, transparent); }
.die span { color: var(--fg); font-size: 13px; }
.toks { display: flex; gap: 8px; flex-wrap: wrap; }
.tok { background: var(--panel2); border: 2px solid currentColor; border-radius: 10px; padding: 8px 12px 8px 10px; display: inline-flex; gap: 8px; align-items: center; font-weight: 700; }
.tok span { color: var(--fg); }
.tok svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
.tok.spent { opacity: .35; border-style: dashed; }
.tok.reserved { box-shadow: 0 0 0 2px var(--accent); }
.tok:disabled { opacity: .9; cursor: default; }
.tok.spent:disabled { opacity: .35; }
.tok.sel { background: color-mix(in srgb, currentColor 22%, var(--panel2)); }
.shapes { display: flex; gap: 8px; flex-wrap: wrap; }
.shape { background: var(--panel2); border: 1px solid var(--line); border-radius: 8px; padding: 8px; display: grid; gap: 2px; align-content: center; }
.shape:hover { border-color: var(--mute); }
.shape[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
.shape i { width: 11px; height: 11px; border-radius: 2px; background: var(--mute); display: block; }
.shape i.y { background: var(--accent); }
.shape i.e { background: transparent; }
.tip { font-size: 13px; color: var(--mute); margin: 0; }
.list { display: grid; gap: 6px; }
.pickrow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; text-align: left; background: var(--panel2); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; }
.pickrow:hover { border-color: var(--accent); }
.pickrow small { color: var(--mute); display: block; font-size: 12px; }
.log { font-size: 13px; display: grid; gap: 3px; max-height: 260px; overflow: auto; }
.log div { color: var(--mute); }
.log div:first-child { color: var(--fg); }
.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); background: var(--fg); color: var(--bg); padding: 9px 14px; border-radius: 9px; font-weight: 600; font-size: 14px; z-index: 50; max-width: calc(100vw - 32px); box-shadow: 0 6px 24px rgba(0,0,0,.35); }
.err { color: var(--bad); font-size: 13px; }
</style>
<div id="app"></div>
<div id="toast" class="toast" hidden></div>
