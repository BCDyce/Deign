      render(); break;
    }
    case 'cancelFlow': UI.flow = null; render(); break;
    case 'pickShape': setShape(Number(el.dataset.i)); break;
    case 'rotate': rotateFlow(); break;
    case 'confirmFlow': confirmFlow(); break;
    case 'skipPending': act({ t: 'resolve', choice: { skip: true } }); break;
    case 'pickEly': act({ t: 'resolve', choice: { id: id } }); break;
    case 'react': act({ t: 'resolve', choice: { yes: el.dataset.yes === '1' } }); break;
