      const cards = []; Object.keys(builder.counts).forEach(function (k) { for (let i = 0; i < builder.counts[k]; i++) cards.push(k); });
      if (D.validatePool(cards)) break;
      cards.sort(function (a, b) { return D.TIER_ORDER.indexOf(D.CARDS[a].tier) - D.TIER_ORDER.indexOf(D.CARDS[b].tier); });
      myPool = { cards: cards, rainbow: builder.rainbow >= 0 && builder.rainbow < cards.length ? builder.rainbow : -1, label: 'Custom' };
      builder.open = false; UI.poolView = null; render(); break;
    }
    case 'startAI': startAI(); break;
    case 'createRoom': createRoom(); break;
    case 'joinRoom': joinRoom(); break;
    case 'rejoin': joinRoom(el.dataset.code); break;
    case 'forgetRoom': store.del('deign.room'); render(); break;
    case 'copyCode':
      try { navigator.clipboard.writeText(net.code).then(function () { toast('Code copied.'); }, function () { toast('Select the code and copy it by hand.'); }); } catch (e) { toast('Select the code and copy it by hand.'); }
      break;
    case 'leaveRoom': store.del('deign.room'); toHome(); break;
    case 'leaveGame': store.del('deign.room'); toHome(); break;
    case 'again': if (UI.lastSetup) { begin(D.newGame({ names: UI.lastSetup.names, pools: UI.lastSetup.pools, ai: [false, true], first: Math.random() < 0.5 ? 0 : 1 }), 0, 'ai'); } break;
    case 'cell': onCell(Number(el.dataset.x), Number(el.dataset.y)); break;
    case 'inspect': { const u = S.aco[id]; UI.insp = { cid: u.cid, aid: id }; render(); break; }
    case 'toggleDie': {
