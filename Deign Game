}
function onRoom(snap) {
  if (!net) return;
  if (!snap.exists) { toast('That room no longer exists.'); store.del('deign.room'); toHome(); return; }
  const d = snap.data(); net.data = d;
  if (d.state && d.ver > net.ver) {
    try {
      S = JSON.parse(d.state); net.ver = d.ver;
      if (view !== 'game') { view = 'game'; UI.rollFor = -1; UI.insp = null; }
      if (UI.flow && !myTurnNow()) UI.flow = null;
      if (UI.sel) { const u = S.aco[UI.sel]; if (!u || u.st !== 'board') UI.sel = null; }
    } catch (e) { toast('Received an unreadable game state.'); }
