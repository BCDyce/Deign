// ------------------------------------------------------------ GAME: highlights
function pickTok(type, unitId) {
  const ts = D.unspent(S).filter(function (t) { return t.type === type; });
  return ts.find(function (t) { return t.only === unitId; }) || ts.find(function (t) { return !t.only; });
}
function validAnchors(f) { const m = {}; f.valid.forEach(function (p) { if (D.VARIANTS[p.vi].shape === f.shape) m[p.ay * W + p.ax] = 1; }); return m; }
function computeHL() {
  const h = { mv: {}, at: {}, pk: {}, pkPath: {}, plok: {}, plbad: {}, anc: {}, land: {} };
  if (!S || S.phase === 'over' || !myTurnNow()) return h;
  const P = S.pending;
  if (P) {
    if (P.kind === 'pickUnit') P.opts.forEach(function (id) { const u = S.aco[id]; if (u.st === 'board') h.pk[u.y * W + u.x] = id; });
    if (P.kind === 'pickPath') P.opts.forEach(function (pid) { S.paths[pid].cells.forEach(function (c) { h.pk[c[1] * W + c[0]] = pid; h.pkPath[c[1] * W + c[0]] = pid; }); });
  }
  if (UI.flow && UI.flow.stage === 'place') {
    const f = UI.flow; h.anc = validAnchors(f);
    if (f.anchor) {
      const ok = D.canPlace(S, me, f.vi, f.anchor[0], f.anchor[1]);
      D.cellsOf(D.VARIANTS[f.vi], f.anchor[0], f.anchor[1]).forEach(function (c) { if (c[0] >= 0 && c[1] >= 0 && c[0] < W && c[1] < H) h[ok ? 'plok' : 'plbad'][c[1] * W + c[0]] = 1; });
      h.land[f.anchor[1] * W + f.anchor[0]] = 1;
    }
    return h;
  }
  if (UI.azr) {
    const u = S.aco[UI.azr.u], v = S.aco[UI.azr.id];
    D.azraelCells(S, u, v).forEach(function (c) { h.pk[c[1] * W + c[0]] = 'azr'; });
    return h;
  }
  if (!P && S.phase === 'act' && UI.sel) {
    const u = S.aco[UI.sel];
    if (u && u.st === 'board' && u.owner === me) {
      if (pickTok('M', u.id)) {
        D.moveDests(S, u).forEach(function (d) { h.mv[d.y * W + d.x] = {}; });
        D.fenrirRuns(S, u).forEach(function (r) { h.mv[r.y * W + r.x] = { dir: r.dir }; });
      }
      if (pickTok('A', u.id)) {
        D.attackTargets(S, u).forEach(function (t) {
          if (t.t === 'font') { const f = S.fonts[t.p]; h.at[f.y * W + f.x] = t; }
          else { const v = S.aco[t.id]; h.at[v.y * W + v.x] = t; }
        });
      }
    }
  }
  return h;
}

// ------------------------------------------------------------ GAME: board
function renderBoard() {
  let h = '';
  for (let dy = 0; dy < H; dy++) for (let dx = 0; dx < W; dx++) {
    const x = me === 1 ? W - 1 - dx : dx, y = me === 1 ? H - 1 - dy : dy, key = y * W + x;
    const pid = S.cells[y][x];
    let cls = 'cell';
    if (pid) cls += S.paths[pid].owner === me ? ' pm' : ' pf';
    if (HL.plok[key]) cls += ' plok'; if (HL.plbad[key]) cls += ' plbad';
    if (HL.mv[key]) cls += ' mv'; if (HL.at[key]) cls += ' at';
    if (HL.pk[key]) cls += ' pk'; if (HL.anc[key]) cls += ' anc'; if (HL.land[key]) cls += ' land';
    if (HL.mv[key] || HL.at[key] || HL.pk[key] || HL.anc[key] || (UI.flow && UI.flow.stage === 'place')) cls += ' can';
    const u = D.unitAt(S, x, y), f = D.fontAt(S, x, y);
    let inner = '';
    if (u) {
      cls += ' can';
      const e = D.stat(S, u), b = cardOf(u).stats;
      const sv = function (v, base) { return v > base ? '<span class="up">' + fmt(v) + '</span>' : (v < base ? '<span class="dn">' + fmt(v) + '</span>' : fmt(v)); };
      inner = '<span class="unit ' + (u.owner === me ? 'me' : 'foe') + (UI.sel === u.id ? ' sel' : '') + '"><b>' + esc(abbr(u.cid)) + '</b><i>' + sv(e.m, b[0]) + '/' + sv(e.a, b[1]) + '/' + sv(e.d, b[2]) + '</i></span>';
    } else if (f >= 0) {
      const fs = D.fontStat(S, f);
      inner = '<span class="unit font ' + (f === me ? 'me' : 'foe') + '"><b>F</b><i>' + fmt(fs.m) + '/' + fmt(fs.a) + '/' + fmt(fs.d) + '</i></span>';
    }
    h += '<button class="' + cls + '" data-act="cell" data-x="' + x + '" data-y="' + y + '" aria-label="Square ' + (x + 1) + ',' + (y + 1) + '">' + inner + '</button>';
  }
  return '<div class="boardwrap"><div class="board" style="grid-template-columns:repeat(' + W + ',minmax(0,1fr));grid-template-rows:repeat(' + H + ',minmax(0,1fr));aspect-ratio:' + W + ' / ' + H + '">' + h + '</div><div class="legend"><span style="--c:var(--me)">You</span><span style="--c:var(--foe)">Opponent</span><span style="--c:var(--ok)">Can move here</span><span style="--c:var(--bad)">Can attack</span></div></div>';
}

