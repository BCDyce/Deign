  let vi = f.vis[0];
  if (f.anchor) { const here = f.vis.filter(function (v) { return D.canPlace(S, me, v, f.anchor[0], f.anchor[1]); }); if (here.length) vi = here[0]; else f.anchor = null; }
  f.vi = vi;
  if (!quiet) render();
}
function flowClick(x, y) {
  const f = UI.flow; if (!f || f.stage !== 'place') return;
  if (D.canPlace(S, me, f.vi, x, y)) f.anchor = [x, y];
  else {
    const alt = f.vis.find(function (v) { return D.canPlace(S, me, v, x, y); });
    if (alt !== undefined) { f.vi = alt; f.anchor = [x, y]; } else toast('That Pathway shape cannot land there. Try another shape or rotate it.');
  }
  render();
}
function rotateFlow() {
  const f = UI.flow; if (!f) return;
  let pool = f.vis;
  if (f.anchor) { const here = f.vis.filter(function (v) { return D.canPlace(S, me, v, f.anchor[0], f.anchor[1]); }); if (here.length) pool = here; }
  const i = pool.indexOf(f.vi);
  f.vi = pool[(i + 1) % pool.length];
  render();
}
function confirmFlow() {
  const f = UI.flow; if (!f || !f.anchor) return;
  const place = { vi: f.vi, ax: f.anchor[0], ay: f.anchor[1] };
  let a;
  if (f.kind === 'descend') a = { t: 'descend', tok: f.tok, aco: f.aco, place: place };
  else if (f.kind === 'sac') a = { t: 'sac', toks: f.toks, aco: f.aco, place: place };
  else a = { t: 'resolve', choice: place };
  UI.flow = null;
  act(a);
}

// ------------------------------------------------------------ acting
function act(a) {
  if (!S) return false;
  const r = D.apply(S, a);
  if (!r.ok) { toast(r.err || 'That is not allowed.'); render(); return false; }
  afterApply(true);
  return true;
}
function afterApply(local) {
  if (UI.sel) { const u = S.aco[UI.sel]; if (!u || u.st !== 'board') UI.sel = null; }
  UI.azr = null;
  if (S.phase !== 'act' || S.pending) { if (S.pending && S.pending.player !== me) UI.flow = null; }
  render();
  if (mode === 'online' && local) queueWrite();
  if (mode === 'ai') schedAI();
}
function onCell(x, y) {
  if (!S) return;
  const u = D.unitAt(S, x, y);
  if (u) UI.insp = { cid: u.cid, aid: u.id };
  if (!myTurnNow()) { render(); return; }
  const key = y * W + x, P = S.pending;
  if (P) {
    if (P.kind === 'pickUnit' && u && P.opts.indexOf(u.id) >= 0) return void act({ t: 'resolve', choice: { id: u.id } });
    if (P.kind === 'pickPath' && HL.pkPath[key]) return void act({ t: 'resolve', choice: { id: HL.pkPath[key] } });
    if (P.kind === 'placePath') return void flowClick(x, y);
    render(); return;
  }
  if (UI.flow) { if (UI.flow.stage === 'place') flowClick(x, y); else render(); return; }
  if (UI.azr) {
    if (HL.pk[key] === 'azr') {
      const az = UI.azr, tok = pickTok('A', az.u);
      UI.azr = null;
      return void act({ t: 'attack', tok: tok.id, u: az.u, target: { t: 'unit', id: az.id }, cell: [x, y] });
    }
    UI.azr = null; render(); return;
  }
  if (S.phase === 'act' && UI.sel) {
    const sel = S.aco[UI.sel];
    if (HL.mv[key]) {
      const tok = pickTok('M', sel.id);
      if (HL.mv[key].dir !== undefined) return void act({ t: 'fenrir', tok: tok.id, u: sel.id, dir: HL.mv[key].dir });
      return void act({ t: 'move', tok: tok.id, u: sel.id, x: x, y: y });
    }
    if (HL.at[key]) {
      const tg = HL.at[key], tok = pickTok('A', sel.id);
      if (tg.tele) { UI.azr = { u: sel.id, id: tg.id }; render(); return; }
      return void act({ t: 'attack', tok: tok.id, u: sel.id, target: tg.t === 'font' ? { t: 'font', p: tg.p } : { t: 'unit', id: tg.id } });
    }
  }
  if (u && u.owner === me && S.phase === 'act') UI.sel = UI.sel === u.id ? null : u.id;
  else UI.sel = null;
  render();
}

// ------------------------------------------------------------ AI
function schedAI() {
  clearTimeout(aiTimer);
  if (mode !== 'ai' || !S || S.phase === 'over' || view !== 'game') return;
  if (actorNow() === me) return;
  aiTimer = setTimeout(function () {
    if (!S || mode !== 'ai' || S.phase === 'over' || actorNow() === me) return;
    try {
      const a = D.aiNext(S);
      const r = D.apply(S, a);
      if (!r.ok) D.apply(S, S.pending ? { t: 'resolve', choice: { skip: true } } : { t: 'end' });
    } catch (e) { console.error(e); try { D.apply(S, { t: 'end' }); } catch (e2) {} }
    afterApply(false);
  }, S.phase === 'roll' ? 900 : 700);
}

// ------------------------------------------------------------ game start / leave
function startAI() {
  setupErr = '';
  const names = [myName.trim() || 'Player', 'Computer'];
  const oi = oppChoice === 'random' ? Math.floor(Math.random() * D.POOLS.length) : Number(oppChoice);
  const pools = [myPool, poolFromPreset(oi)];
  begin(D.newGame({ names: names, pools: pools, ai: [false, true], first: Math.random() < 0.5 ? 0 : 1 }), 0, 'ai');
  UI.lastSetup = { names: names, pools: pools };
}
function begin(game, seat, m) {
  S = game; me = seat; mode = m; view = 'game';
  UI.sel = null; UI.flow = null; UI.azr = null; UI.rollFor = -1; UI.insp = null; UI.confirmResign = false;
  render(); if (m === 'ai') schedAI();
  window.scrollTo(0, 0);
}
function toHome() {
  clearTimeout(aiTimer); leaveNet(); S = null; view = 'home'; render();
}

// ------------------------------------------------------------ online
const CODE_CHARS = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
function genCode() { let c = ''; for (let i = 0; i < 5; i++) c += CODE_CHARS[Math.floor(Math.random() * CODE_CHARS.length)]; return c; }
function leaveNet() { if (net) { try { net.unsub && net.unsub(); } catch (e) {} clearTimeout(net.timer); net = null; } if (mode === 'online') mode = 'ai'; }
async function createRoom() {
  setupErr = '';
  if (!dbApi || !uid) { setupErr = 'Online play is not available in this view.'; render(); return; }
  try {
    let code = '', ref = null;
    for (let i = 0; i < 6; i++) { code = genCode(); ref = dbApi.doc('rooms/' + code); const s = await ref.get(); if (!s.exists) break; ref = null; }
    if (!ref) throw new Error('Could not find a free room code. Try again.');
    await ref.set({ status: 'lobby', created: Date.now(), seat0: { uid: uid, name: myName.trim() || 'Player 1', pool: myPool }, seat1: null, state: null, ver: 0 });
    enterRoom(code, 0);
  } catch (e) { setupErr = 'Could not create the room: ' + (e && e.message || e && e.code || 'unknown error'); render(); }
}
async function joinRoom(codeIn) {
  setupErr = '';
  const code = String(codeIn || joinCode).toUpperCase().replace(/[^A-Z0-9]/g, '');
  if (code.length !== 5) { setupErr = 'Enter the 5-character room code.'; render(); return; }
  if (!dbApi || !uid) { setupErr = 'Online play is not available in this view.'; render(); return; }
  try {
    const ref = dbApi.doc('rooms/' + code), snap = await ref.get();
    if (!snap.exists) { setupErr = 'No room with that code.'; render(); return; }
    const d = snap.data(); let seat;
    if (d.seat0 && d.seat0.uid === uid) seat = 0;
    else if (d.seat1 && d.seat1.uid === uid) seat = 1;
    else if (!d.seat1) {
      await ref.update({ seat1: { uid: uid, name: myName.trim() || 'Player 2', pool: myPool } });
      seat = 1;
    } else { setupErr = 'That room already has two players.'; render(); return; }
    enterRoom(code, seat);
  } catch (e) { setupErr = 'Could not join: ' + (e && e.message || e && e.code || 'unknown error'); render(); }
}
function enterRoom(code, seat) {
  leaveNet();
  const ref = dbApi.doc('rooms/' + code);
  net = { code: code, ref: ref, seat: seat, ver: 0, writing: false, again: false, unsub: null, starting: false, data: null, timer: null };
  me = seat; mode = 'online'; view = 'lobby'; S = null;
  store.set('deign.room', code);
  net.unsub = ref.onSnapshot(onRoom, function (e) { toast('Connection lost: ' + (e && e.code || 'error')); });
