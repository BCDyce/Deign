<script>
/* DEIGN engine: pure rules + AI. Works in browser (window.Deign) and Node (module.exports). */
(function (root) {
'use strict';

// ============================================================ CONFIG (tune here)
const W = 13, H = 12;                       // board size (cols x rows)
const MAX_ROLL = 3, FIRST_TURN_ROLL = 2;
const TURN_CAP = 400;                       // draw if the game drags past this many turns
const TIER_ORDER = ['apex', 'gold', 'silver', 'bronze'];
const TIER_LABEL = { apex: 'Snow / Obsidian', gold: 'Gold', silver: 'Silver', bronze: 'Bronze' };
// D = Descension, M = Movement, A = Attack. The rules do not list the faces of each die, so these are placeholders.
const DICE_FACES = {
  apex:    ['D', 'M', 'M', 'A', 'A', 'A'],
  gold:    ['D', 'M', 'M', 'A', 'A', 'A'],
  silver:  ['D', 'M', 'M', 'M', 'A', 'A'],
  bronze:  ['D', 'D', 'M', 'M', 'A', 'A'],
  rainbow: ['D', 'D', 'M', 'M', 'A', 'A']
};
// Pathway (Descension) shapes, read from the attached diagram. Cells are [col,row]; the anchor is the yellow square the Acolyte lands on.
// Players may rotate or flip a shape, like a physical tile.
const PATH_SHAPES = [
  { name: '1', cells: [[0,0],[0,1],[1,1],[2,1],[2,2],[3,2]], anchor: [2,1] },
  { name: '2', cells: [[2,0],[0,1],[1,1],[2,1],[3,1],[3,2]], anchor: [2,1] },
  { name: '3', cells: [[1,0],[0,1],[1,1],[2,1],[2,2],[3,2]], anchor: [2,1] },
  { name: '4', cells: [[0,0],[0,1],[1,1],[2,1],[3,1],[3,2]], anchor: [2,1] },
  { name: '5', cells: [[0,0],[1,0],[1,1],[2,1],[2,2],[3,2]], anchor: [2,1] }
];

// ============================================================ CARDS
const CARDS = {};
function C(id, name, tier, sub, st, abil, text, tags) {
  CARDS[id] = { id: id, name: name, tier: tier, sub: sub, stats: st, abil: abil || null, text: text || '', tags: tags || [] };
}
// ---- Snow / Obsidian
C('albie','Albie the Primordial Zoa','apex','Snow',[3,3,3],'albie','When descended, gain an effect for each Zoa Acolyte on the board (stacks): Ella: enemy Movement -1. Angus: enemy Attack -1. Lucas: attacks up to 3 squares away. Charlotte: immune to enemy Acolyte effects.');
C('seojun','Seo-Jun, Mutagenic Advancement','apex','Snow',[2,2,2],'seojun','While on the board, all Acolytes without an effect gain Attack and Defence equal to this Acolyte\'s Attack and Defence.');
C('andromeda','Andromeda, Unchained','apex','Obsidian',[3,5,5],'andromeda','While on the board, may attack as many squares away as there are Little Stars on the field (including across unbuilt ground).');
C('lilili','Lilili the Abomination','apex','Obsidian',[3,3,1],'lilili','Can attack and be attacked by both players\' Acolytes. When it destroys an Acolyte, that Acolyte\'s original Attack and Defence are added to its own. The victim goes to Lilili\'s Zone, not Elysium.');
C('heaven10','The 10th Heaven','apex','Snow',[1,2,2],'heaven10','When descended, if your Font has survived 3 battles, you win the game.');
C('heaven5','5th Heaven Above','apex','Snow',[0,1,1],'heaven5','While on the board, when another of your Acolytes is attacked, you may swap it with your Font, which is attacked instead.');
C('d20',"D20, Combat's Risk",'apex','Snow',[2,2,2],'d20','While on the board, if three Descension results are rolled at the start of your turn, you win.');
C('rose','Rose the Ruinous Requiem','apex','Snow',[3,1,1],'rose','Cannot attack. When your turn ends, destroy either player\'s Acolytes standing on the same Pathway as Rose.');
C('disObs','The Disaster, Wind, Storm and Flames','apex','Obsidian',[2,3,3],'disObs','When descended, destroy every enemy Acolyte on a straight line (row, column or diagonal) between this and another of your Disaster Acolytes.',['disaster']);
C('creator','The Unruly Creator','apex','Snow',[1,1,1],'creator','When descended, replace as many enemy Acolytes as possible with Acolytes from your own Elysium (the enemy keeps control of the replacements). Replaced Acolytes go to Elysium.');
C('abu','Abu, Charming the Corrupted','apex','Snow',[2,2,2],'abu','When descended, hatch all of your Egg Acolytes.');
C('basilisk','The Egg of the Basilisk','apex','Obsidian',[0,0,0],'egg5','At the end of the 3rd of your turns it hatches and gains +5/+5/+5.',['egg']);
C('emiliano','Emiliano, Null Imprint','apex','Obsidian',[3,4,4],'emiliano','While on the board, all Acolytes\' stat changes are reverted to their original Movement, Attack and Defence.');
C('gogmagog',"Gogmagog, Justice's Mace",'apex','Snow',[3,4,3],'gogmagog','While on the board, all opponent\'s Acolytes lose their effects. Your own Gigantes keep theirs.',['gigante']);
C('fenrir',"Fenrir, Shadow's Trail of Death",'apex','Obsidian',[0,0,5],'fenrir','When it moves, it may slide in a straight line as far as the Path allows. Passed Acolytes are pushed one square. Pushed off the Path onto unbuilt board means destroyed.');
C('clarissa','Clarissa, Omniscient Gaze','apex','Obsidian',[4,4,4],'clarissa','While on the board, all unbuilt ground may be moved across by your Acolytes.');
C('azrael','Azrael, Be Afraid of the Dark','apex','Snow',[0,2,2],'azrael','While on the board, when it would attack, first move it adjacent to any enemy Acolyte anywhere on the board.');
// ---- Gold
C('dusan','Dusan the Faraday Cage','gold','Gold',[2,2,2],'dusan','While on the board, if Anina is on the board, enemy Acolytes on this Acolyte\'s Pathway cannot Move or Attack.');
