// ------------------------------------------------------------ flow (descend / sacrifice / Yan placement)
function startFlow(kind, data) {
  const fixed = kind === 'yanPlace' ? S.pending.shape : undefined;
  const valid = D.placements(S, me, fixed);
  if (!valid.length) { toast('There is nowhere legal to place that Pathway.'); UI.flow = null; return false; }
  const shapes = []; valid.forEach(function (p) { const s = D.VARIANTS[p.vi].shape; if (shapes.indexOf(s) < 0) shapes.push(s); });
  shapes.sort();
  UI.flow = Object.assign({ kind: kind, valid: valid, shapes: shapes, shape: shapes[0], anchor: null, stage: 'place', fixed: fixed !== undefined }, data);
  setShape(shapes[0], true);
  return true;
}
function visFor(f, shape) { const v = []; f.valid.forEach(function (p) { if (D.VARIANTS[p.vi].shape === shape && v.indexOf(p.vi) < 0) v.push(p.vi); }); return v; }
