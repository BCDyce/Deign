  if (!p0 || !p1) { toast('One of the pools is not valid.'); net.starting = false; return; }
  try {
    const g = D.newGame({ names: [String(d.seat0.name).slice(0, 20), String(d.seat1.name).slice(0, 20)], pools: [p0, p1], ai: [false, false] });
    S = g; net.ver = 1; view = 'game'; UI.rollFor = -1; render();
    await net.ref.update({ status: 'playing', state: JSON.stringify(g), ver: 1 });
  } catch (e) { toast('Could not start the game.'); net.starting = false; }
}
function queueWrite() {
