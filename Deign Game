function validatePool(cards) {
  if (cards.length !== 10) return 'A Pool needs exactly 10 Acolytes (has ' + cards.length + ').';
  const cnt = {};
  cards.forEach(function (c) { cnt[c] = (cnt[c] || 0) + 1; });
  for (const k in cnt) {
    const cd0 = CARDS[k]; if (!cd0) return 'Unknown card ' + k;
    if (cd0.tags.indexOf('star') >= 0) continue;
    const lim = cd0.tier === 'apex' ? 1 : 3;
    if (cnt[k] > lim) return cd0.name + ': at most ' + lim + ' allowed.';
