// Presents Firebase Realtime Database through the small doc()/get()/set()/update()/onSnapshot() surface the lobby code uses.
function fbAdapter(fb) {
  const db = fb.database();
  const wrap = function (s) { return { exists: s.exists(), data: function () { return s.val(); } }; };
  return {
    doc: function (path) {
      const ref = db.ref(path);
      return {
        get: function () { return ref.get().then(wrap); },
        set: function (d) { return ref.set(d); },
        update: function (d) { return ref.update(d); },
        onSnapshot: function (cb, err) {
          const h = ref.on('value', function (s) { cb(wrap(s)); }, function (e) { if (err) err({ code: e && e.code || 'error' }); });
          return function () { ref.off('value', h); };
        }
      };
    }
  };
}
