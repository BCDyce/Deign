    if (pair.length >= 2 && bronzeLeft && D.sacDie(S, me).length) sac += '<button class="btn sm" data-act="sac" data-type="' + ty + '">Ritual Sacrifice: 2× ' + FACE_NAME[ty] + ' → Bronze</button>';
