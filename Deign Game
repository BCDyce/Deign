    case 'goSetup': setupMode = el.dataset.mode; setupErr = ''; builder.open = false; view = 'setup'; render(); break;
    case 'pickPool': { const i = Number(el.dataset.i); myPool = poolFromPreset(i); builder.open = false; UI.poolView = null; render(); break; }
    case 'poolInspect': UI.poolView = el.dataset.cid; render(); break;
    case 'openBuilder': {
      builder.open = true; builder.counts = {}; myPool.cards.forEach(function (c) { builder.counts[c] = (builder.counts[c] || 0) + 1; }); builder.rainbow = -1; render(); break;
    }
    case 'closeBuilder': builder.open = false; render(); break;
    case 'bqty': {
      const k = el.dataset.id, d = Number(el.dataset.d); builder.counts[k] = Math.max(0, (builder.counts[k] || 0) + d); if (!builder.counts[k]) delete builder.counts[k]; builder.rainbow = -1; render(); break;
    }
